# =============================================================================
# Medicare Frontend — Environment Variables (example / single source of truth)
# =============================================================================
# Copy this file to `.env` and fill in real values. VITE_* vars are baked into
# the build at COMPILE TIME, so you must rebuild after changing them.
#
# Production frontend: https://www.medicares.in
# Production backend:  https://medicare-sih.onrender.com
# =============================================================================

# ---- Backend API base URL ----
# Production build points at the live Render backend. For local dev, use the
# localhost line instead and restart `vite`.
VITE_API_URL=https://medicare-sih.onrender.com
# VITE_API_URL=http://localhost:4000

# ---- Razorpay (payments) ----
VITE_RAZORPAY_KEY_ID=

# ---- PowerSync (offline dashboard) ----
# Same instance URL as the backend's POWERSYNC_URL. Leave blank to run
# online-only (the app falls back to the axios stores automatically).
VITE_POWERSYNC_URL=

# Backend endpoint that mints a per-user PowerSync JWT.
# Defaults to `${VITE_API_URL}/api/powersync/token` if unset.
VITE_POWERSYNC_TOKEN_ENDPOINT=

# Optional dev toggle: "true" | "false". If unset, PowerSync is enabled iff
# VITE_POWERSYNC_URL is set.
VITE_POWERSYNC_ENABLED=

# Optional: enable verbose API request logging in dev builds. "true" | "false".
VITE_DEBUG_API=
